# setup.jasielrivera.com
#   browsers           -> index.html (instructions)
#   curl / wget at /   -> bootstrap.sh, so `curl -fsSL https://setup.jasielrivera.com | bash` works
#   /bootstrap.sh      -> the script, for anything
# Coolify's proxy terminates TLS and forwards here on :80.
:80 {
	root * /srv
	header Cache-Control "no-store"
	header Vary "User-Agent"

	@script path /bootstrap.sh
	@cli_root {
		path /
		header_regexp User-Agent (?i)^(curl|wget)/
	}

	handle @script {
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle @cli_root {
		rewrite * /bootstrap.sh
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle / {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
